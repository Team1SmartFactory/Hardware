<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mqtt_bridge</name>
  <version>0.0.1</version>
  <description>
    Team1SmartFactory 로봇(ROS2) <-> 백엔드(FastAPI/MQTT) 브리지.
    계약은 docs/COMMAND_SCHEMA.md 참고.
  </description>
  <maintainer email="a691285@gmail.com">jam0629</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <!-- 팔/비글 모두 raw Action이 아니라 std_msgs/String(JSON) 토픽으로 스테이션
       태스크 매니저에 말을 건다 (ROS2_WIRING.md §1) — control_msgs/trajectory_msgs는
       필요 없다. -->
  <depend>std_msgs</depend>

  <exec_depend>python3-paho-mqtt</exec_depend>
  <exec_depend>python3-pydantic</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
